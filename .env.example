# Copy this file to `.env` and fill in real values.

# SQLite by default. Example Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/events
DATABASE_URL=sqlite:///./events.db

# Discord -> Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Comma separated. "*" is fine while developing.
CORS_ORIGINS=*

# Populate the DB with mock events on first boot (great for demos)
SEED_ON_STARTUP=true

# Real scrapers hit live websites. Keep OFF until you've read the site's ToS.
ENABLE_LIVE_SCRAPERS=true